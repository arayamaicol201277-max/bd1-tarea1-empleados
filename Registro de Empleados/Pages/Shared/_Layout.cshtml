<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Registro de Empleados</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Registro de Empleados.styles.css" asp-append-version="true" />
</head>
<!--Estructura general de la aplicación-->
<body>
    <header>
        <!--Crea la barrade navegación superior-->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Registro de Empleados</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <!--Despliega las páginas a las quese quere dar acceso al usuario-->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!--Página principal-->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
                        <!--Página de desglose de empleados-->  
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Manejo de Empleados/Empleados">Empleados Actuales</a>
                        </li>
                        <!--Página de inserción de empleados-->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Manejo de Empleados/Insertar">Agregar Empleados</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!--
        Página de privacidad en el footer
        Estoy Considerando eliminar la razor page de Privacidad pero no sé si eso pueda afectar a la aplicación
        por lo que la dejo por el momento
    -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Registro de Empleados - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>