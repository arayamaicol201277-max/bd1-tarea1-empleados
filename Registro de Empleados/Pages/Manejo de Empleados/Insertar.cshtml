@page
@model Registro_de_Empleados.Pages.Manejo_de_Empleados.InsertarModel
@{
	ViewData["Title"] = "Insertar Nuevos Empleados";
}

<h1>Agregar Empleados</h1>
<!--Esta página se encarga de la inserción de nuevos empleados-->

<h1>Edit</h1>

<!--form para solicitar los datos del nuevo empleado-->
<form method= "post" class = "mt-3">
<!--formateo e input para el nombre,   PENDIENNTE-->
<div class = "form-group row">
	<div class = "col-sm-10">
		<input/>
	</div>
</div>
<!--formateo e input para el salario,	PENDIENTE-->
<div class = "form-group row">
	<div class = "col-sm-10">
		<input/>
	</div>
</div>
<!--Botón para validar e insertar el Empleado en la BD,		PENDIENTE-->
<div class = "form-group row">
	<div class = "col-sm-10">
		<button type= "submit" class ="btn btn-primary">Insertar</button>
	</div>
</div>
</form>