@page
@model Registro_de_Empleados.Pages.EmpleadosModel
@{
    ViewData["Title"] = "Desglose de Empleados";
}

<h1>Empleados</h1>
<!--Esta es la página en la que se desplegará el desglose de los empleados en orden alfabético-->

<!--Definición de la tabla donde se mostraran los empleados-->
<table class = "table">
    <!--Header de la tabla-->
  <thead class = "thead-dark">
    <tr>
      <th scope="col">ID</th>
      <th scope="col">Nombre</th>
      <th scope="col">Salario</th>
    </tr>
  </thead>
  <!--Ciclo for each para desplegar los Empleados  ver Employees/Index en Razor Demo, no me deja comentar el esqueleto si lo pongo aquí-->
</table>

