@page
@model WebApplication1.Pages.InsertarModel
@{
    ViewData["Title"] = "Insertar Nuevos Empleados";
}

<h1>Agregar Empleado</h1>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<form method="post" class="mt-3">
    <div class="form-group row mb-3">
        <label asp-for="Nombre" class="col-sm-2 col-form-label">Nombre:</label>
        <div class="col-sm-6">
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row mb-3">
        <label asp-for="Salario" class="col-sm-2 col-form-label">Salario:</label>
        <div class="col-sm-6">
            <input asp-for="Salario" class="form-control" />
            <span asp-validation-for="Salario" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-sm-6">
            <button type="submit" class="btn btn-primary">Insertar</button>
            <a asp-page="Empleados" class="btn btn-secondary">Regresar</a>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}